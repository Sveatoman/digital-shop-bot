# === Telegram ===
BOT_TOKEN=1234567890:AAA-your-bot-token-from-BotFather

# === Администраторы (ID через запятую) ===
ADMIN_IDS=123456789

# === База данных ===
DB_PATH=shop.db

# === Платежи (счета в USDT, баланс в рублях) ===
# CryptoBot (@CryptoBot) — создать приложение: @CryptoBot -> Crypto Pay -> Create App
CRYPTOBOT_TOKEN=
# XRocket Crypto (@xRocketCryptoBot) — получить ключ в боте
XROCKET_TOKEN=

# === Курс рубля к USDT ===
# auto — Binance (USDTRUB), при сбое open.er-api.com
# binance — только Binance, без фолбэков
# manual — всегда USD_RATE ниже
RATE_MODE=auto
# Резервный курс (₽ за 1 USDT), если сеть недоступна
USD_RATE=92.0

# Минимальная сумма пополнения (в рублях)
MIN_DEPOSIT=100

# === Прочее ===
SHOP_NAME=💎 Digital Shop
# Ссылка на канал/чат поддержки
SUPPORT_URL=
